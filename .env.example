# ================================================================
#  WellnessMitra — Environment Configuration
#  Fill in your API keys below, then save this file as .env
# ================================================================

# ── Google Gemini AI (REQUIRED) ───────────────────────────────────
# Get free key: https://aistudio.google.com → Get API Key
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ── Google Maps / Places API (OPTIONAL for Gym Finder) ────────────
# Get key: https://console.cloud.google.com
# Enable: Places API + Geocoding API
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_KEY_HERE

# ── Local JSON Data Storage ───────────────────────────────────────
# All data (users, workouts, progress, meals, foods) is stored locally in data/*.json
# No database setup or external nutrition API required!
DATA_DIR=./data

# ── Application ───────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=wellnessmitra-local-dev-secret-change-in-production
CORS_ORIGINS=http://localhost:3000
