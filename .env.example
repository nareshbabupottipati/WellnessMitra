# ================================================================
#  WellnessMitra — Environment Configuration
#  Fill in your API keys below, then save this file as .env
# ================================================================

# ── Google Gemini AI (REQUIRED) ───────────────────────────────────
# Get free key: https://aistudio.google.com → Get API Key
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ── Local Maps & Gym Directory ────────────────────────────────────
# Gyms & fitness centers are loaded 100% locally from data/gyms.json!
# Free browser search links (Google Maps & OpenStreetMap) are generated automatically.
# No Google Cloud billing or Maps API key required!

# ── Local JSON Data Storage ───────────────────────────────────────
# All data (users, workouts, progress, meals, foods, gyms) is stored locally in data/*.json
DATA_DIR=./data

# ── Application ───────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=wellnessmitra-local-dev-secret-change-in-production
CORS_ORIGINS=http://localhost:3000
