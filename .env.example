# ================================================================
#  WellnessMitra — Environment Configuration
#  Fill in your API keys below, then save this file
# ================================================================

# ── Google Gemini AI (REQUIRED) ───────────────────────────────────
# Get free key: https://aistudio.google.com → Get API Key
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ── Google Maps / Places API (REQUIRED for Gym Finder) ───────────
# Get key: https://console.cloud.google.com
# Enable: Places API + Geocoding API
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_KEY_HERE

# ── Edamam Food & Nutrition API (REQUIRED for Nutrition module) ───
# Free account: https://developer.edamam.com → Food Database API
EDAMAM_APP_ID=YOUR_EDAMAM_APP_ID
EDAMAM_APP_KEY=YOUR_EDAMAM_APP_KEY

# ── Database (no changes needed for local dev) ────────────────────
DATABASE_URL=sqlite:///./fitness_agent.db

# ── Application ───────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=wellnessmitra-local-dev-secret-change-in-production
CORS_ORIGINS=http://localhost:3000
